# Copy this file to deploy/.env.production on the server and replace every placeholder.
# Never commit deploy/.env.production.

MONGO_ROOT_USERNAME=catbakery_admin
MONGO_ROOT_PASSWORD=replace-with-a-long-random-password

DOUYIN_APP_ID=replace-with-douyin-app-id
DOUYIN_APP_SECRET=replace-with-douyin-app-secret

# Generate with: openssl rand -hex 32
AUTH_TOKEN_SECRET=replace-with-at-least-32-random-characters
AUTH_TOKEN_TTL_SECONDS=604800
