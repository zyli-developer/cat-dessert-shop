# Node
node_modules/
dist/

# Cocos Creator
client/library/
client/local/
client/temp/
client/build/
client/profiles/
# Cocos asset metadata stores stable UUIDs and must be versioned with source assets.
*.meta
!client/assets/*.meta
!client/assets/**/*.meta

# IDE
.idea/
.vscode/
*.iml
.codex/

# OS
.DS_Store
Thumbs.db

# Local recovery and generated helper files
.git-repair-backup-*.zip
__pycache__/
*.py[cod]
/bundle-config.d.ts
/bundle-utils.ccc

# Env
.env
.env.local

# 抖音开发者工具（构建产物）
**/bytedance-mini-game/
# 但保留构建模板
!client/build-templates/bytedance-mini-game/

# Cocos Creator extensions（第三方插件，通过 git clone 安装）
client/extensions/cocos-mcp-server/

# Claude Code
.claude/settings.json

# Skills（通过 npx skills 安装）
.agents/
.kiro/
.trae/
.windsurf/
skills-lock.json

# Test automation
coverage/
playwright-report/
test-results/
# Re-include e2e/dist/ so we can selectively track the web-mobile bundle.
# The bare `dist/` above would otherwise hide the whole e2e/dist tree.
!e2e/dist/
e2e/dist/*
# Cocos web-mobile bundle is built by `npm run build:e2e-bundle` and
# committed so CI e2e tests can run without a Cocos Creator install.
!e2e/dist/web-mobile/
.asset-backups/
