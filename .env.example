# Cat Bakery 本地配置模板
#
# 使用方法：
#   1. 将本文件复制为仓库根目录 .env
#   2. 按下面说明替换配置值
#   3. 执行 npm run config:sync，将允许公开的客户端配置写入 Cocos 源码
#
# 根目录 .env 已被 Git 忽略，禁止提交任何真实密钥。
# ECS 生产后端使用 deploy/.env.production，不会读取本地 .env。

# =============================================================================
# 客户端公开配置
# =============================================================================
# 以下 3 项会被 npm run config:sync 编译进小游戏包，任何玩家都可能看到。
# 这里绝对不能放 App Secret、数据库密码、Token 密钥等敏感信息。

# [必填] NestJS 后端的公网根地址，不要以 / 结尾。
# 抖音真机和正式发布必须使用 HTTPS，并在抖音开放平台配置为 request 合法域名。
CLIENT_API_BASE_URL=https://jingjingyeye.vip:8099

# [正式发布必填] 抖音开放平台创建的“激励视频广告位 ID”。
# 填广告位 ID，不是广告位名称；项目中所有奖励入口共用这一个广告位。
REWARDED_AD_UNIT_ID=replace-with-real-rewarded-video-ad-unit-id

# [可选，默认 false] 是否跳过真实广告并模拟“完整观看”。
# 仅用于本地调试奖励流程；提审和正式发布必须为 false。
MOCK_REWARDED_ADS=false

# =============================================================================
# 服务端：抖音登录
# =============================================================================
# 以下配置只由 NestJS 读取，不会同步进客户端。

# [真实登录必填] 抖音小游戏 App ID，应与当前小游戏应用一致。
DOUYIN_APP_ID=replace-with-douyin-app-id

# [敏感，真实登录必填] 抖音小游戏 App Secret，只能保存在服务端。
DOUYIN_APP_SECRET=replace-with-douyin-app-secret

# =============================================================================
# 服务端：会话鉴权
# =============================================================================

# [敏感，生产必填] 用于签发和校验登录 Token，长度至少 32 个字符。
# 可用 openssl rand -hex 32 生成；修改后，之前签发的 Token 会全部失效。
# 开发环境留空时会随机生成临时密钥，但服务重启后旧 Token 会失效。
AUTH_TOKEN_SECRET=replace-with-at-least-32-random-characters

# [可选，默认 604800] Token 有效期，单位为秒；604800 秒等于 7 天。
AUTH_TOKEN_TTL_SECONDS=604800

# =============================================================================
# 服务端：数据库与监听地址
# =============================================================================

# [本地可选，生产必填] MongoDB 连接字符串。
# 本地不设置时会先探测 127.0.0.1:27017，仍不可用则启动临时内存数据库。
# 使用内存数据库的数据会在服务退出后丢失；需要持久化时请明确设置本项。
MONGODB_URI=mongodb://127.0.0.1:27017/catbakery

# [可选，默认 3333] NestJS 监听端口。ECS Docker 内部端口由生产 Compose 固定为 8099。
PORT=3333

# [可选，默认 0.0.0.0] NestJS 监听地址；0.0.0.0 允许容器或局域网访问。
HOST=0.0.0.0

# [本地固定为 development] 设为 production 后，服务端会强制要求 AUTH_TOKEN_SECRET。
# ECS Docker 已在 docker-compose.prod.yml 中固定注入 production。
NODE_ENV=development

# [可选] 登录 code 兑换方式：
#   留空  = 调用抖音官方 jscode2session，要求正确配置 App ID 和 App Secret
#   stub  = 使用内置假账号表，仅供自动化测试或本地假登录，禁止生产使用
AUTH_CODE_EXCHANGER=
