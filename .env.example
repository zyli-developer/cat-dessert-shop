# 抖音小游戏配置（开发阶段使用测试账号）
DOUYIN_APP_ID=tt_test_appid
DOUYIN_APP_SECRET=tt_test_secret

# 后端服务
MONGODB_URI=mongodb://localhost:27017/catbakery
PORT=3333

# 鉴权 code 兑换实现选择：
#   stub  -> 使用内置 StubCodeExchanger（测试/本地联调用，按预置表返回 openid）
#   其它/未设置 -> 使用 DouyinCodeExchanger（生产环境调用抖音 jscode2session）
AUTH_CODE_EXCHANGER=stub
